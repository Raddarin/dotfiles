{
  "position": "top",
  "margin-top": 5,
  "modules-left": [
    //"hyprland/workspaces"
    "custom/workspaces",
  ],
  "custom/workspaces": {
    "format": "{}",
    "return-type": "json",
    "escape": false, // LIVSVIKTIGT för att Pango-taggarna ska fungera
    "exec": "/home/Raddarin/.config/scripts/hypr-waybar-icons/target/release/hypr-waybar-icons",
    "restart-interval": 0 // Vi behöver inte detta eftersom vi kör en listener
  },
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    //"custom/spell-check",
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "custom/ram",
    "cpu",
  ],
  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d}"
  },
  // "hyprland/workspaces": {
  //   "format": "{name}",
  //   "on-click": "activate",
  //   "sort-by-number": true
  // },
  //"custom/spell-check": {
  // "format": "󰓆 ",
  //"tooltip": false
  //},
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": " ",
    "tooltip-format": "{volume}%",
    "format-icons": {
      "default": [
        "󰕿 ", // Mycket lågt (0-14%)
        "󰖀 ", // Lågt (15-28%)
        "󰖀 ", // Mellan-lågt (29-42%)
        "󰕾 ", // Mellan (43-57%)
        "󰕾 ", // Mellan-högt (58-71%)
        "󰕾 ", // Högt (72-85%)
        " " // Max (86-100%)
      ]
    },
    "scroll-step": 1,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false
  },
  "network": {
    "version": 2, // Valfritt, men rekommenderas i nyare Waybar för nätverksdata
    "interval": 1,
    "format-wifi": " ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "⬇ {bandwidthDownBits} ⬆ {bandwidthUpBits}",    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "alacritty -e bash -ic 'nmtui'"
  },
  "bluetooth": {
    "format-on": "",          // Visas på laptopen när BT är igång
    "format-off": "󰂲",         // Visas på laptopen om du stänger av BT
    "format-disabled": "󰂲",    // 󰂲 = Struket B. Visas på PC:n eftersom BT saknas/är spärrat
    "format-no-controller": "󰂲", // Säkerhetsåtgärd för PC:n (visar struket B om ingen hårdvara hittas)
    "tooltip-format": "{status}",
    "on-click": "alacritty -e bash -ic 'bluetuith'" // Eller din favorit-BT-manager
  },
  // "custom/bluetooth": {
  //   "exec": "~/.config/waybar/scripts/bluetooth_status.sh",
  //   "return-type": "json",
  //   "interval": 5,
  //   "on-click": "blueman-manager",
  //   "on-click-right": "rfkill toggle bluetooth",
  //   "tooltip": true
  // },
  "battery": {
    "interval": 60,
    "format": "{icon}",
    "format-none": "", // VIKTIGT: Gömmer modulen helt på din PC (där batteri saknas)
    "states": {
      "warning": 10
    },
    "tooltip-format": "{capacity}% kvar ({timeTo})",
    "tooltip-format-charging": "{capacity}% laddat ({timeTo})",
    "tooltip-format-plugged": "{capacity}% [Ansluten]",
    "format-icons": {
      "default": [
        "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
      ],
      "charging": [
        "󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"
      ]
    }
  },
  "custom/ram": {
    "format": " {}",
    "tooltip": false,
    "interval": 5,
    "on-click": "alacritty -e btop",
    "exec": "free -h | awk '/Mem:/ {print $3}'"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 1
  }
}
